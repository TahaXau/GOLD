var gm=new THREE.LineBasicMaterial({color:0xe3b95c,transparent:true,opacity:.25});for(var k=0;k<=4;k++){var y=-1.3+3.3*k/4,gl=new THREE.Line(new THREE.BufferGeometry().setFromPoints([new THREE.Vector3(-3.5,y,-.9),new THREE.Vector3(3.5,y,-.9)]),gm);can.add(gl)}}
