[[-1.25,.62],[1.25,.62],[-1.25,-.62],[1.25,-.62]].forEach(function(p){bar(p[0],-.98,p[1])});bar(0,-.2,.62);bar(0,-.2,-.62);bar(0,.58,0);
var cs=[],C=D.candles||[];
if(C.length>2){var lo=Math.min.apply(0,C.map(function(c){return c[2]})),hi=Math.max.apply(0,C.map(function(c){return c[1]})),n=C.length,sx=6.6/n,sy=3.3/(hi-lo),UP=new THREE.MeshPhongMaterial({color:0x2fbf8a,specular:0xbbffdd,shininess:70,emissive:0x0b3324}),DN=new THREE.MeshPhongMaterial({color:0xe5484d,specular:0xffc0c4,shininess:70,emissive:0x3a0c0e});
C.forEach(function(c,i){var up=c[3]>=c[0],m=up?UP:DN,g=new THREE.Group(),bh=Math.max(Math.abs(c[3]-c[0])*sy,.05),body=new THREE.Mesh(new THREE.BoxGeometry(sx*.62,bh,sx*.62),m),wh=Math.max((c[1]-c[2])*sy,.05),wick=new THREE.Mesh(new THREE.BoxGeometry(.035,wh,.035),m);
